{
  "name": "connectx-control",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ConnectX Control - management, email, audit, and signed Android app releases; SMS is delivered directly by EMS and ConnectX Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test test/",
    "pages:dev": "wrangler pages dev dist --port 8788 --ip 0.0.0.0",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=connectxweb",
    "db:reset:local": "wrangler d1 execute connectx-control --local --file=./schema/connectx_schema.sql",
    "db:reset:remote": "wrangler d1 execute connectx-control --remote --file=./schema/connectx_schema.sql"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^11.10.0",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.86.0"
  }
}
